{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/duplexforge/metadata.schema.json",
  "title": "DuplexForge rendered dialogue",
  "type": "object",
  "required": [
    "schema_version",
    "goal",
    "scenario",
    "language",
    "duration_ms",
    "sample_rate",
    "audio",
    "events"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "goal": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "language": { "enum": ["ko", "en", "es", "fr"] },
    "duration_ms": { "type": "integer", "minimum": 1 },
    "sample_rate": { "type": "integer", "minimum": 8000 },
    "audio": {
      "type": "object",
      "required": ["user", "assistant", "mixed"],
      "properties": {
        "user": { "type": "string" },
        "assistant": { "type": "string" },
        "mixed": { "type": "string" }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "speaker",
          "text",
          "event_type",
          "start_ms",
          "end_ms",
          "duration_ms"
        ],
        "properties": {
          "id": { "type": "string" },
          "speaker": { "enum": ["user", "assistant"] },
          "text": { "type": "string", "minLength": 1 },
          "event_type": {
            "enum": [
              "normal",
              "backchannel",
              "interruption",
              "pause_fragment",
              "resume"
            ]
          },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "duration_ms": { "type": "integer", "minimum": 1 },
          "audio_path": { "type": "string" },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
