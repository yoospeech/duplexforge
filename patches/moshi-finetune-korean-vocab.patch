 logger = logging.getLogger(__name__)
 
 
+def _expand_text_vocab_weights(model, state_dict: dict[str, torch.Tensor]) -> None:
+    """Pad pretrained text-vocabulary weights when a tokenizer adds IDs."""
+    targets = model.state_dict()
+    names = ("text_emb.weight", "depformer_text_emb.weight", "text_linear.weight")
+    for source_name in names:
+        if source_name not in state_dict:
+            continue
+        target_name = source_name
+        if target_name not in targets and source_name == "text_linear.weight":
+            target_name = "text_linear.frozen_W.weight"
+        if target_name not in targets:
+            continue
+        source = state_dict[source_name]
+        target = targets[target_name]
+        if tuple(source.shape) == tuple(target.shape):
+            continue
+        if source.ndim != target.ndim or source.shape[1:] != target.shape[1:] or source.shape[0] > target.shape[0]:
+            raise ValueError(f"incompatible vocabulary tensor {source_name}")
+        extra_shape = (target.shape[0] - source.shape[0], *source.shape[1:])
+        extra = torch.empty(extra_shape, dtype=source.dtype, device=source.device)
+        torch.nn.init.trunc_normal_(extra, mean=0.0, std=1 / math.sqrt(source.shape[-1]))
+        state_dict[source_name] = torch.cat((source, extra), dim=0)
+        logger.info("Expanded %s from %d to %d vocabulary rows", source_name, source.shape[0], target.shape[0])
+
+
+def _freeze_existing_vocab_rows(param: torch.nn.Parameter, start: int) -> None:
+    def mask_old_rows(grad: torch.Tensor) -> torch.Tensor:
+        grad = grad.clone()
+        grad[:start] = 0
+        return grad
+    param.register_hook(mask_old_rows)
+
+
 def main_logger_info(message: str) -> None:
     if get_rank() == 0:
         logger.info(message)
