+def _expand_text_vocab_state(model: LMModel, state: dict[str, torch.Tensor]) -> None:
+    """Extend base text weights when a tokenizer appends vocabulary IDs."""
+    expected = model.state_dict()
+    for name in ("text_emb.weight", "depformer_text_emb.weight", "text_linear.weight"):
+        if name not in state or name not in expected:
+            continue
+        source, target = state[name], expected[name]
+        if tuple(source.shape) == tuple(target.shape):
+            continue
+        if source.ndim != target.ndim or source.shape[1:] != target.shape[1:] or source.shape[0] > target.shape[0]:
+            raise ValueError(
+                f"incompatible vocabulary tensor {name}: "
+                f"checkpoint={tuple(source.shape)}, model={tuple(target.shape)}"
+            )
+        extra = torch.empty(
+            (target.shape[0] - source.shape[0], *source.shape[1:]),
+            dtype=source.dtype,
+            device=source.device,
+        )
+        torch.nn.init.trunc_normal_(extra, mean=0.0, std=1 / math.sqrt(source.shape[-1]))
+        state[name] = torch.cat((source, extra), dim=0)
+
